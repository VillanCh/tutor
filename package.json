    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "lucide-react": "^1.55.0",
    "mammoth": "1.13.0",
    "motion": "^14.1.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
